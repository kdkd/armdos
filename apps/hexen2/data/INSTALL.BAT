@ECHO OFF
REM INSTALL.BAT - checks the Hexen II data for H2.EXE (ARM-DOS)
REM H2CHECK tests DATA1\PAK0.PAK: size, pak directory and CRC-32.
ECHO.
ECHO Hexen II for ARM-DOS - checking the game data...
ECHO.
IF NOT EXIST C:\GAMES\HEXEN2\DATA1\PAK0.PAK GOTO NODATA
C:\GAMES\HEXEN2\H2CHECK C:\GAMES\HEXEN2\DATA1\PAK0.PAK
IF ERRORLEVEL 1 GOTO BAD
ECHO.
ECHO Hexen II is ready.  Type HEXEN2 to play.
GOTO END

:NODATA
ECHO C:\GAMES\HEXEN2\DATA1\PAK0.PAK is not there yet.
ECHO.
MORE < C:\GAMES\HEXEN2\HOWTO.TXT
GOTO END

:BAD
ECHO.
ECHO Copy PAK0.PAK from the Hexen II demo into C:\GAMES\HEXEN2\DATA1 again.
ECHO See C:\GAMES\HEXEN2\README.TXT.

:END
