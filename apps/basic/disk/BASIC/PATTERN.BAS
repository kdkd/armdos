10 REM PATTERN.BAS - 256 colours in SCREEN 13 (320x200)
20 SCREEN 13
30 FOR R = 100 TO 2 STEP -2
40   CIRCLE (160, 100), R, 32 + (R MOD 72)
50 NEXT R
60 FOR I = 0 TO 319 STEP 8
70   LINE (I, 0)-(319 - I, 199), 16 + (I \ 8) MOD 16
80 NEXT I
90 FOR Y = 0 TO 15: FOR X = 0 TO 15
100   LINE (X * 5, Y * 5)-(X * 5 + 4, Y * 5 + 4), Y * 16 + X, BF
110 NEXT X, Y
120 DRAW "BM240,20 C15 R40 D40 L40 U40 BM250,30 C14 P14,15"
130 LOCATE 25, 1: PRINT "Press a key";
140 A$ = INKEY$: IF A$ = "" THEN 140
150 SCREEN 0
