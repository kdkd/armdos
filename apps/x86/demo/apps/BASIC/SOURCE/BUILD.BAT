@ECHO OFF
REM BUILD.BAT - assemble GW-BASIC from its source code, on the ARM PC.
REM
REM The source is Microsoft's GW-BASIC (1983), released under the MIT
REM licence in 2020, with the OEM modules written by D. Spinellis, S. Gros
REM and T.K. Chia (same licence).  The assembler and linker are Microsoft's
REM MASM 5.10 and LINK 3.65 from the MS-DOS 4.00 source release (MIT).
REM All three are x86 programs: ELBOW runs them, translated to ARM code.
REM It takes a minute or two.  The result is GWBASIC.EXE in this directory.
ECHO Assembling 38 modules of GW-BASIC with MASM 5.10 ...
IF EXIST MATH.ASM DEL MATH.ASM
COPY MATH1.ASM+MATH2.ASM MATH.ASM > NUL
ECHO GWDATA
ELBOW MASM GWDATA; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO ADVGRP
ELBOW MASM ADVGRP; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO BIMISC
ELBOW MASM BIMISC; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO BIPRTU
ELBOW MASM BIPRTU; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO BIPTRG
ELBOW MASM BIPTRG; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO BISTRS
ELBOW MASM BISTRS; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO CALL86
ELBOW MASM CALL86; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO DSKCOM
ELBOW MASM DSKCOM; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO FIVEO
ELBOW MASM FIVEO; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GENGRP
ELBOW MASM GENGRP; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIO86
ELBOW MASM GIO86; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOCAS
ELBOW MASM GIOCAS; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOCOM
ELBOW MASM GIOCOM; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOCON
ELBOW MASM GIOCON; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIODSK
ELBOW MASM GIODSK; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOKYB
ELBOW MASM GIOKYB; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOLPT
ELBOW MASM GIOLPT; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOSCN
ELBOW MASM GIOSCN; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GIOTBL
ELBOW MASM GIOTBL; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWEVAL
ELBOW MASM GWEVAL; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWLIST
ELBOW MASM GWLIST; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWMAIN
ELBOW MASM GWMAIN; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWRAM
ELBOW MASM GWRAM; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWSTS
ELBOW MASM GWSTS; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO IBMRES
ELBOW MASM IBMRES; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO KANJ86
ELBOW MASM KANJ86; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO MACLNG
ELBOW MASM MACLNG; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO MATH
ELBOW MASM MATH; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO NEXT86
ELBOW MASM NEXT86; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO SCNDRV
ELBOW MASM SCNDRV; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO SCNEDT
ELBOW MASM SCNEDT; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO OEM
ELBOW MASM OEM; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO OEMCBK
ELBOW MASM OEMCBK; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO OEMEV
ELBOW MASM OEMEV; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO OEMSND
ELBOW MASM OEMSND; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO ITSA86
ELBOW MASM ITSA86; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO GWINIT
ELBOW MASM GWINIT; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO BIBOOT
ELBOW MASM BIBOOT; > NUL
IF ERRORLEVEL 1 GOTO FAIL
ECHO Linking with LINK 3.65 ...
ELBOW LINK @GWBASIC.LNK > NUL
IF ERRORLEVEL 1 GOTO FAIL
DEL *.OBJ
ECHO.
ECHO Done: GWBASIC.EXE, assembled and linked on an ARM.  Try ELBOW GWBASIC.
GOTO END
:FAIL
ECHO The build stopped on an error (run the last command by hand to see it).
:END
