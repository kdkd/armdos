+/* The asm operand allocator works with hardware register numbers (r0-r8),
+   but load()/store() take code generator registers, where 4 is r12:
+   translate (0x20+n = raw hardware register n, see intr() in arm-gen.c).
+   ARM-DOS fix: operands in r4-r8 were loaded into the wrong register. */
+static int asm_treg(int hw)
+{
+    if (hw < 4)
+        return hw;
+    if (hw == 12)
+        return TREG_R12;
+    return 0x20 + hw;
+}
