+    keep = tcc_mallocz(s1->nb_sections * sizeof(int));
+    for (i = 1; i < s1->nb_sections; i++) {
+        s = s1->sections[i];
+        if (!(s->sh_flags & SHF_ALLOC)) {
+            keep[i] = 1;
+            continue;
+        }
+        if (s == text_section || s == data_section || s == rodata_section
+            || s == bss_section
+            || s->sh_type == SHT_INIT_ARRAY || s->sh_type == SHT_FINI_ARRAY
+            || s->sh_type == SHT_PREINIT_ARRAY
+            || (strncmp(s->name, ".text.", 6) && strncmp(s->name, ".rodata.", 8)
+                && strncmp(s->name, ".data.", 6) && strncmp(s->name, ".bss.", 5)))
+            keep[i] = 2;
+    }
