+/* call a run-time ABI helper with the 'nargs' values on top of the stack;
+   the result (of type 't') is left in r0 (r0:r1 for a double/long long) */
+static void sf_call(int func, int nargs, int t)
+{
+    vpush_helper_func(func);
+    vrott(nargs + 1);
+    gfunc_call(nargs);
+    vpushi(0);
+    vtop->type.t = t;
+    vtop->r = REG_IRET;
+    if ((t & VT_BTYPE) == VT_LLONG || (t & VT_BTYPE) == VT_DOUBLE
+        || (t & VT_BTYPE) == VT_LDOUBLE)
+        vtop->r2 = REG_IRE2;
+}
+
+/* generate a floating point operation 'v = t1 op t2'. The two operands
+   are guaranteed to have the same floating point type. */
+void gen_opf(int op)
+{
+    int dbl = (vtop->type.t & VT_BTYPE) != VT_FLOAT;
+    int func, cmp = 0, t = vtop->type.t;
+
+    tcc_state->uses_float = 1;
+    switch (op) {
+    case '+': func = dbl ? TOK___aeabi_dadd : TOK___aeabi_fadd; break;
+    case '-': func = dbl ? TOK___aeabi_dsub : TOK___aeabi_fsub; break;
+    case '*': func = dbl ? TOK___aeabi_dmul : TOK___aeabi_fmul; break;
+    case '/': func = dbl ? TOK___aeabi_ddiv : TOK___aeabi_fdiv; break;
+    /* the comparison helpers return 1/0, false when unordered (NaN) */
+    case TOK_EQ: func = dbl ? TOK___aeabi_dcmpeq : TOK___aeabi_fcmpeq; cmp = TOK_NE; break;
+    case TOK_NE: func = dbl ? TOK___aeabi_dcmpeq : TOK___aeabi_fcmpeq; cmp = TOK_EQ; break;
+    case TOK_LT: case TOK_ULT:
+        func = dbl ? TOK___aeabi_dcmplt : TOK___aeabi_fcmplt; cmp = TOK_NE; break;
+    case TOK_LE: case TOK_ULE:
+        func = dbl ? TOK___aeabi_dcmple : TOK___aeabi_fcmple; cmp = TOK_NE; break;
+    case TOK_GT: case TOK_UGT:
+        func = dbl ? TOK___aeabi_dcmpgt : TOK___aeabi_fcmpgt; cmp = TOK_NE; break;
+    case TOK_GE: case TOK_UGE:
+        func = dbl ? TOK___aeabi_dcmpge : TOK___aeabi_fcmpge; cmp = TOK_NE; break;
+    default:
+        tcc_error("unknown fp op %x!", op);
+        return;
+    }
+    if (cmp) {
+        sf_call(func, 2, VT_INT);
+        vpushi(0);
