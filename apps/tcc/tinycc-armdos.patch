+   compiled code), init/fini arrays, anything not named .text.*, .rodata.*,
+   .data.*, .bss.*, and whatever a kept section refers to. */
+static void armdos_gc_sections(TCCState *s1)
+{
+    int i, changed, *keep, entry;
