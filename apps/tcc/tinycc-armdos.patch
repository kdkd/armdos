+/* mrs Rd, cpsr|spsr   msr cpsr_<fields>|spsr_<fields>, Rm|#imm (ARM-DOS) */
+static void asm_psr_opcode(TCCState *s1, int token)
+{
+    Operand op;
+    int spsr = 0, mask = 0, t;
+
+    if (ARM_INSTRUCTION_GROUP(token) == TOK_ASM_mrseq) {
+        parse_operand(s1, &op);
+        if (op.type != OP_REG32)
+            expect("register");
+        skip(',');
+        if (tok == TOK_ASM_spsr)
+            spsr = 1;
+        else if (tok != TOK_ASM_cpsr && tok != TOK_ASM_apsr_nzcv)
+            expect("cpsr or spsr");
+        next();
+        asm_emit_opcode(token, 0x010F0000 | (spsr << 22) | (op.reg << 12));
+        return;
+    }
+    t = tok;
+    switch (t) {
+    case TOK_ASM_cpsr: case TOK_ASM_cpsr_fsxc: case TOK_ASM_cpsr_cxsf: mask = 15; break;
+    case TOK_ASM_cpsr_c: mask = 1; break;
+    case TOK_ASM_cpsr_f: case TOK_ASM_apsr_nzcv: mask = 8; break;
+    case TOK_ASM_cpsr_fc: case TOK_ASM_cpsr_cf: mask = 9; break;
+    case TOK_ASM_spsr: case TOK_ASM_spsr_fsxc: case TOK_ASM_spsr_cxsf: mask = 15, spsr = 1; break;
+    case TOK_ASM_spsr_c: mask = 1, spsr = 1; break;
+    case TOK_ASM_spsr_f: mask = 8, spsr = 1; break;
+    case TOK_ASM_spsr_fc: case TOK_ASM_spsr_cf: mask = 9, spsr = 1; break;
+    default: expect("cpsr_<fields> or spsr_<fields>");
+    }
+    next();
+    skip(',');
+    parse_operand(s1, &op);
+    if (op.type == OP_REG32) {
+        asm_emit_opcode(token, 0x0120F000 | (spsr << 22) | (mask << 16) | op.reg);
+    } else {
+        uint32_t v = op.e.v, r;
+        for (r = 0; r < 32; r += 2) {
+            uint32_t x = r ? (v << r) | (v >> (32 - r)) : v;
+            if (x < 256) {
+                asm_emit_opcode(token, 0x0320F000 | (spsr << 22) | (mask << 16) | ((r / 2) << 8) | x);
+                return;
+            }
+        }
+        tcc_error("immediate value cannot be encoded");
+    }
+}
