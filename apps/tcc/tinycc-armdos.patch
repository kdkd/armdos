+static void armdos_extent(TCCState *s1, addr_t *image_end, addr_t *mem_end,
+                          Section **last_bits, Section **last_any)
+{
+    int i;
+    Section *s;
+    *image_end = *mem_end = 0;
+    *last_bits = *last_any = NULL;
+    for (i = 1; i < s1->nb_sections; i++) {
