+            *image_end = s->sh_addr + s->sh_size, *last_bits = s;
+        if (s->sh_addr + s->sh_size >= *mem_end)
+            *mem_end = s->sh_addr + s->sh_size, *last_any = s;
+    }
+    /* 8-aligned, like __image_end, __bss_start__ and __bss_end__ in the
+       SDK's link.ld (layout_sections() starts .bss there): crt0 zeroes
+       .bss a word at a time from __bss_start__, and ARMv5 word stores
+       ignore the low address bits: an unaligned start cleared the last
+       bytes of the section before it (with Arm's newlib-nano, the
+       program's own .data: a string lost its last character). */
+    *image_end = (*image_end + 7) & ~(addr_t)7;
+    *mem_end = (*mem_end + 7) & ~(addr_t)7;
